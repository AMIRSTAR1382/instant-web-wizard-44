# Apache / LiteSpeed settings (cPanel, DirectAdmin and most shared hosts).
# Upload this file together with everything else from the dist/ folder.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # After SSL (https) is active on your domain, remove the "#" from the next three lines
  # so every visitor is sent to the secure address.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Single-page app: any address that isn't a real file is handled by index.html,
  # so /gaming or /community/... work when opened directly or refreshed.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# The page itself must never be cached for long, or visitors would miss updates.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
</IfModule>

# Compress text files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
