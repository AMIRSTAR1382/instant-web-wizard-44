# Settings for building the site. Nothing here is required: the defaults work as they are.
# To change one, copy this file to .env and fill it in (.env is never committed).

# Where the site finds its backend (PocketBase).
# Leave empty in the normal setup, where PocketBase serves the site itself (see DEPLOY.md).
# Set it only if the site and the backend live at different addresses, e.g. https://api.example.com
VITE_API_URL=

# ---------------------------------------------------------------------------------------------
# Server settings are NOT read from this file. Set them where the server runs
# (Liara: your app > Settings > Environment variables). All are optional; see DEPLOY.md.
#
#   APP_URL=https://example.com              your site's address, used in links inside emails
#   TRUSTED_PROXY_HEADER=X-Forwarded-For     the visitor's real IP behind the host's proxy
#   SMTP_HOST=smtp.example.com               email sending (sign-up confirmation, password reset)
#   SMTP_PORT=587
#   SMTP_USERNAME=...
#   SMTP_PASSWORD=...                        keep it in the hosting panel, never in the repository
#   SMTP_TLS=false                           true for port 465
#   MAIL_SENDER_ADDRESS=no-reply@example.com
#   MAIL_SENDER_NAME=Explore
